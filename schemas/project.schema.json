{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/launch80/AwesomeList/main/schemas/project.schema.json",
  "title": "Launch80 catalog project",
  "description": "One community-owned repository. Omit a field when it is unknown; never guess.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "tagline", "use_it_if", "kind", "categories", "maturity", "links", "people", "hardware", "verification"],
  "properties": {
    "id": { "$ref": "vocabulary.schema.json#/$defs/id" },
    "name": { "type": "string", "description": "Display name, usually owner/repo." },
    "tagline": { "type": "string", "maxLength": 140, "description": "One-line outcome: what you get from it." },
    "use_it_if": { "type": "string", "description": "Who this is for, in one sentence starting with 'You'." },
    "description": { "type": "string" },
    "kind": { "$ref": "vocabulary.schema.json#/$defs/kind" },
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "description": "First entry is the primary README section; others add cross-links.",
      "items": { "$ref": "vocabulary.schema.json#/$defs/category" }
    },
    "maturity": { "$ref": "vocabulary.schema.json#/$defs/maturity" },
    "audience": { "$ref": "vocabulary.schema.json#/$defs/audience" },
    "links": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "mirrors": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "setup_guide": { "type": "string", "format": "uri" },
        "docker_image": { "type": "string", "format": "uri" },
        "writeup": { "type": "string", "format": "uri" },
        "discussion": { "type": "string", "format": "uri" }
      }
    },
    "people": {
      "type": "object", "additionalProperties": false, "required": ["builders"],
      "properties": {
        "builders": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Discord handles of the people who built it." },
        "shared_by": { "type": "array", "items": { "type": "string" }, "description": "Discord handles of the members who shared it, if not the builder." },
        "contributors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "description": "Hard requirements. Set agnostic: true for tools that do not depend on a GPU family.",
      "properties": {
        "agnostic": { "type": "boolean" },
        "vendors": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/vendor" } },
        "architectures": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/architecture" } },
        "gpu_models": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "IDs from catalog/compatibility/gpu-models.yaml the author targeted." },
        "gpu_count": {
          "type": "object", "additionalProperties": false,
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        },
        "min_vram_gb": { "type": "number", "minimum": 0 },
        "host_notes": { "type": "string" }
      }
    },
    "software": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "runtimes": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/runtime" } },
        "os": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/os" } },
        "os_versions": { "type": "array", "items": { "type": "string" } },
        "rocm": { "$ref": "vocabulary.schema.json#/$defs/version_range" },
        "python": { "$ref": "vocabulary.schema.json#/$defs/version_range" },
        "container": { "type": "boolean", "description": "True if the documented path runs in Docker/Podman." },
        "stack_notes": { "type": "string", "description": "Exact versions as stated by the author." },
        "based_on": { "type": "array", "items": { "$ref": "vocabulary.schema.json#/$defs/id" }, "description": "Catalog IDs this project builds on." }
      }
    },
    "provides": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/feature" } },
    "supports": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model_families": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/model_family" } },
        "models": { "type": "array", "items": { "type": "string" }, "description": "Models the author ran, as named by the author." },
        "quantizations": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/quantization" } },
        "topologies": { "type": "array", "uniqueItems": true, "items": { "$ref": "vocabulary.schema.json#/$defs/topology" } }
      }
    },
    "not_suitable_for": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" }, "description": "Machine-readable disqualifiers, e.g. 'os:windows' or 'rocm:<7.0'." },
    "quick_start": { "type": "string", "description": "Copyable first command(s), only if taken from the project's docs." },
    "known_issues": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "$ref": "vocabulary.schema.json#/$defs/id" }, "description": "Benchmark record IDs." },
    "recipes": { "type": "array", "items": { "$ref": "vocabulary.schema.json#/$defs/id" } },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["level"],
      "properties": {
        "level": { "$ref": "vocabulary.schema.json#/$defs/verification_level" },
        "last_verified": { "type": "string", "format": "date" },
        "last_commit_checked": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "tested_by": { "type": "array", "items": { "type": "string" } },
        "listed_since": { "type": "string", "format": "date", "description": "Date the entry was added to the list." }
      }
    },
    "notes": { "type": "string" }
  }
}
